    <CopyFileToFolders Include="RayTracing.hlsl">
      <FileType>Document</FileType>
    </CopyFileToFolders>
  </ItemGroup>
  <!-- DXR needs DXIL (shader model 6.3+), which FXC can't produce - so
       RayTracing.hlsl is compiled with DXC at runtime instead
       (App::InitRaytracingPipeline). Both DLLs ship with the Windows SDK:
       dxcompiler.dll is the compiler, and dxil.dll is what signs the DXIL
       it produces. Without a signature D3D12 rejects the shader outright
       unless Developer Mode is on, so copying dxcompiler.dll alone gives a
       confusing runtime failure rather than a build error. -->
  <Target Name="CopyDxcRuntime" AfterTargets="Build">
    <ItemGroup>
      <DxcRuntime Include="$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll" />
      <DxcRuntime Include="$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" />
    </ItemGroup>
    <Error Condition="'@(DxcRuntime)' == ''"
           Text="dxcompiler.dll / dxil.dll not found under $(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64 - step 16 needs a Windows SDK that ships DXC." />
    <Copy SourceFiles="@(DxcRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
